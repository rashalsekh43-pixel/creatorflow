# Copy this file to .env and add the values from your Supabase project.
# The publishable key is safe for browser use when Row Level Security is enabled.
# Never put a service_role key or database password in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
